generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core tables). People sign in through the Mock Bank, see src/lib/mock-bank-auth.ts.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  profile         Profile?
  wallets         UserWallet[]
  bankCustomer    BankCustomer?
  dealDrafts      DealDraft[]
  friendsAsked    Friendship[]     @relation("friendRequester")
  friendsReceived Friendship[]     @relation("friendAddressee")
  groups          GroupMember[]
  aliases         ContactAlias[]
  agentChats      AgentChat[]
  kyc             KycVerification?
  kycApplication  KycApplication?
  stripeLink      StripeLink?
  preference      UserPreference?
  groupInvites    GroupInvite[]
  dealTemplates   DealTemplate[]
  blocksMade      UserBlock[]      @relation("blocker")
  blockedBy       UserBlock[]      @relation("blocked")
  reportsMade     UserReport[]     @relation("reporter")
  reportsAbout    UserReport[]     @relation("reported")
  security        UserSecurity?
  address       UserAddress?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per linked sign-in method (providerId "google" | "apple").
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// App data linked to a user
// ---------------------------------------------------------------------------

/// Basic personal details, 1:1 with User. Everything optional so sign-in never blocks on it.
model Profile {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String?
  lastName     String?
  phone        String?
  dateOfBirth  DateTime? @db.Date
  organization String?
  jobTitle     String?
  country      String?   @db.Char(2) /// ISO 3166-1 alpha-2, e.g. "TH"
  locale       String    @default("en") /// "en" | "th", matches the UI language switch
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum WalletRole {
  OWNER
  APPROVER
  CONTRACTOR
  VIEWER
}

/// Links a signed-in user to on-chain AgentWallets (the indexed Wallet table) and, through it,
/// to that wallet's Proposal / Approval / Event rows.
model UserWallet {
  userId        String
  walletAddress String
  role          WalletRole @default(OWNER)
  label         String?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet     @relation(fields: [walletAddress], references: [address], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, walletAddress])
  @@index([walletAddress])
}

/// Who approved which proposal, so the UI doesn't need one hasApproved() call per approver.
model Approval {
  walletAddress   String
  proposalId      BigInt
  approver        String
  approvedAtBlock BigInt
  approvedAt      DateTime
  proposal        Proposal @relation(fields: [walletAddress, proposalId], references: [walletAddress, proposalId])

  @@id([walletAddress, proposalId, approver])
}

/// Full audit log: every AgentWallet + MilestoneEscrow event, unpaginated.
model Event {
  id            String   @id @default(cuid())
  walletAddress String
  txHash        String
  logIndex      Int
  eventName     String
  args          Json
  blockNumber   BigInt
  blockTime     DateTime
  wallet        Wallet   @relation(fields: [walletAddress], references: [address])

  @@unique([txHash, logIndex])
  @@index([walletAddress, blockNumber])
}

/// Last block the indexer processed per contract, so it resumes instead of rescanning from 0.
model IndexerSyncState {
  contractAddress String   @id
  lastSyncedBlock BigInt
  updatedAt       DateTime @updatedAt
}

/// Mirrors AgentWallet.Proposal, kept in sync from ProposalCreated/Approved/Executed/Cancelled.
model Proposal {
  walletAddress  String
  proposalId     BigInt
  kind           ProposalKind
  proposer       String
  target         String
  amount         Decimal        @db.Decimal(78, 0)
  milestoneIndex Decimal        @db.Decimal(78, 0)
  data           String
  reason         String
  expiresAt      DateTime
  approverEpoch  BigInt
  approvalsCount Int            @default(0)
  status         ProposalStatus @default(OPEN)
  createdBlock   BigInt
  updatedBlock   BigInt
  approvals      Approval[]
  wallet         Wallet         @relation(fields: [walletAddress], references: [address])

  @@id([walletAddress, proposalId])
  @@index([walletAddress, status])
}

/// One row per AgentWallet deployed by AgentWalletFactory (WalletCreated event).
model Wallet {
  address      String       @id
  owner        String
  agent        String
  creator      String
  token        String
  createdBlock BigInt
  createdAt    DateTime
  events       Event[]
  proposals    Proposal[]
  members      UserWallet[]

  @@index([owner])
}

enum ProposalKind {
  TRANSFER
  RELEASE_MILESTONE
  CALL
  SETUP_DEAL
}

enum ProposalStatus {
  OPEN
  EXECUTED
  CANCELLED
  EXPIRED
  STALE
}

// ---------------------------------------------------------------------------------------------
// Mock Bank (demo only): simulated baht and yuan, not real money. Amounts are integer minor units
// (satang, fen). Every mTHB / mCNY on-chain is backed by money in that currency's RESERVE account:
// reserve balance == totalSupply. Money never moves between currencies.
// ---------------------------------------------------------------------------------------------

/// Which demo bank: THB = Mock Bank Thailand, CNY = Mock Bank China.
enum Currency {
  THB
  CNY
}

enum BankCustomerType {
  PERSONAL
  COMPANY
}

/// A Mock Bank customer. Signing in to the app means signing in here and letting the app use some
/// of the customer's accounts (like open-banking consent), instead of Google or Apple.
model BankCustomer {
  id          String           @id @default(cuid())
  currency    Currency
  /// Chosen at sign-up, unique within one bank.
  username    String
  displayName String
  type        BankCustomerType @default(PERSONAL)
  /// Demo PIN, hashed (scrypt). Never a real bank PIN.
  pinHash     String
  failedPins  Int              @default(0)
  lockedUntil DateTime?
  /// The app user this customer signs in as; set on the first consent, cleared when the user is deleted.
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// When the customer last agreed to let the app use the linked accounts.
  consentedAt DateTime?
  /// Reviewer access to the chain explorer (/admin/chain). Set only by scripts/make-admin.mts.
  isAdmin     Boolean          @default(false)
  createdAt   DateTime         @default(now())

  accounts BankAccount[]

  @@unique([currency, username])
}

enum BankAccountKind {
  USER
  RESERVE
  /// Money leaving the demo bank for a PromptPay id or another bank (simulated, one per currency).
  EXTERNAL
}

enum BankTransferKind {
  /// Between two of the app's own accounts: a member moving money into a company account.
  TRANSFER
  /// Demo money entering the bank (a sandbox's seed). The only kind with no source account.
  DEPOSIT
  /// Buyer → reserve, right before mTHB / mCNY is minted for a deal.
  FUND
  /// Reserve → buyer, when funding failed for certain or a deal refunds.
  REFUND
  /// Reserve → seller (or buyer), after the tokens are redeemed on-chain.
  PAYOUT
  /// An invited seller's earnings → the payout destination they chose (a Mock Bank account, or
  /// the EXTERNAL account standing in for PromptPay / another bank).
  WITHDRAW
  /// Money paid in by card through Stripe (test mode), credited once per Checkout Session.
  TOPUP
}

model BankAccount {
  id           String          @id @default(cuid())
  kind         BankAccountKind @default(USER)
  /// The on-chain address this account belongs to (a sandbox's AgentWallet, or a seller). Null for the reserve.
  ownerAddress String?         @unique
  label        String
  /// Never negative: a debit only happens together with a balance check in the same statement.
  balance      BigInt          @default(0)
  currency     Currency        @default(THB)
  /// Passbook number shown to the customer. Null for the reserves and sandbox accounts.
  accountNo    String?         @unique
  customerId   String?
  customer     BankCustomer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Set while the customer lets the app use this account. Only linked accounts are shown or debited.
  linkedAt     DateTime?
  /// The linked account the app debits by default.
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())

  outgoing BankTransfer[] @relation("outgoing")
  incoming BankTransfer[] @relation("incoming")

  @@index([customerId])
}

model BankTransfer {
  id             String           @id @default(cuid())
  /// One key per action, e.g. "deal-123:fund"; the database refuses a second transfer with it.
  idempotencyKey String           @unique
  kind           BankTransferKind
  fromId         String?
  toId           String
  amount         BigInt
  /// The on-chain transaction this transfer mirrors (mint or redeem), once known.
  txHash         String?
  createdAt      DateTime         @default(now())

  /// Restrict: a deleted account must never turn a transfer into what looks like a deposit.
  from BankAccount? @relation("outgoing", fields: [fromId], references: [id], onDelete: Restrict)
  to   BankAccount  @relation("incoming", fields: [toId], references: [id])

  @@index([fromId])
  @@index([toId])
}

// ---------------------------------------------------------------------------------------------
// Deal drafts (PDPA): what the agent drafts for a bank-paid file deal. Names, titles and
// milestone descriptions live only here, where they can be deleted; the chain gets their hash.
// ---------------------------------------------------------------------------------------------

enum DealDraftStatus {
  /// What the AI proposed: shown only in its chat card, listed nowhere, until the user confirms it.
  PREVIEW
  DRAFT
  FUNDED
  FAILED
  CANCELLED
}

/// Who drafted the deal: the buyer (locks money when approved) or the seller (offers work; the
/// buyer pays in when they accept).
enum DraftSide {
  BUY
  SELL
}

/// What is traded: HIRE is work done by a person (a service), GOODS is a thing bought (a file, or a
/// parcel shipped by post).
enum DealKind {
  HIRE
  GOODS
}

model DealDraft {
  id             String          @id @default(cuid())
  side           DraftSide       @default(BUY)
  kind           DealKind        @default(HIRE)
  /// Delivery address for parcel milestones (shown to both parties only).
  shipTo         String?
  /// SELL drafts: the buyer's wallet the offer is made to. BUY drafts: null (the wallet is the buyer).
  buyer          String?
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress  String
  seller         String
  title          String
  summary        String
  /// [{ name, amount (minor units, string), hasFile, due, acceptance }]
  milestones     Json
  reviewHours    Int
  /// sha256 of the terms, written on-chain as the offer's termsURI ("sha256:<hex>").
  termsHash      String
  status         DealDraftStatus @default(DRAFT)
  /// The mandate's EIP-712 digest once approved: the funding record's id.
  fundingId      String?
  /// Set while one request approves the draft: a second click waits instead of funding it twice (DB-01).
  approvingUntil DateTime?
  /// The other side has no account yet: their name. Their link (and wallet) is made on Confirm.
  inviteName     String?
  /// The SellerInvite (a purchase) or BuyerInvite (a sale) made for them on Confirm.
  inviteId       String?
  dealId         Int?
  /// An amendment: confirming this draft first withdraws that deal (still an unaccepted offer),
  /// then makes this one with the same other party (and the same private link).
  replacesDealId Int?
  /// Last funding result (steps, tx hashes, error), for the UI.
  result         Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  files          DealFile[]

  @@index([userId, walletAddress])
}

// ---------------------------------------------------------------------------------------------
// Social: friends and groups. Being friends never allowlists anyone: adding a friend as a payee
// is a separate owner action. A group deal needs `threshold` member votes before the proposer's
// own bank account is debited, so a group shares decisions, not a pot of idle money.
// ---------------------------------------------------------------------------------------------

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  requester   User             @relation("friendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("friendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/// A deal saved for reuse: everything but the other party. Using one asks the AI to draft a new
/// preview from it (another person, maybe other amounts), so it still goes through Confirm.
model DealTemplate {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  side       DraftSide    @default(BUY)
  kind       DealKind     @default(HIRE)
  title      String
  summary    String       @default("")
  /// [{ name, amount, delivery, acceptance, dueDays }]
  milestones Json
  uses       Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
}

/// One user blocking another: no contact requests, transfers, deals or group invites between them
/// (both ways), and an existing contact is removed.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Optional witnesses named on a deal's contract, one per side (buyer / seller).
/// A file the deal's creator attached for the other side to see (a spec, a catalogue, a sample,
/// a quotation). Kept with the draft, so it follows the deal; both parties (and an invited outsider
/// through their link) can open it. At most 5 per deal, 4 MB each.
model DealFile {
  id        String    @id @default(cuid())
  draftId   String
  draft     DealDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())

  @@index([draftId])
}

model DealWitness {
  id        String   @id @default(cuid())
  escrow    String
  dealId    Int
  side      String
  name      String
  contact   String   @default("")
  addedById String?
  createdAt DateTime @default(now())

  @@unique([escrow, dealId, side])
}

/// Second factors (demo). PIN: scrypt hash. Face / fingerprint / passkey: a WebAuthn credential id
/// on this device (the signature is not verified server-side in the demo). SMS: simulated. Email
/// OTP: a 6-digit code mailed (shown on screen when no mailer is configured).
model UserSecurity {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(false)
  /// Methods turned on: "pin" | "face" | "fingerprint" | "passkey" | "sms" | "email"
  methods       String[]  @default([])
  pinHash       String?
  credentialIds String[]  @default([])
  phone         String?
  otpHash       String?
  otpExpires    DateTime?
  otpTries      Int       @default(0)
  updatedAt     DateTime  @updatedAt
}

enum ReportReason {
  SCAM
  SPAM
  HARASSMENT
  IMPERSONATION
  NOT_DELIVERED
  OTHER
}

/// A user reporting another from Contacts, for the admin to review.
model UserReport {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  reporter   User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User         @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String       @default("")
  status     String       @default("OPEN")
  createdAt  DateTime     @default(now())

  @@index([reportedId])
  @@index([reporterId])
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Group {
  id          String   @id @default(cuid())
  name        String
  currency    Currency
  createdById String
  /// Signer votes a group deal (or a rule change) needs before it happens (N of M signers).
  threshold   Int
  createdAt   DateTime @default(now())

  members   GroupMember[]
  proposals GroupProposal[]
  invites   GroupInvite[]
  links     GroupLink[]
  rules     GroupRuleProposal[]
  /// Set when this group is a company's signers, or has its own group wallet: its deals are paid
  /// from (and its sales paid into) that wallet.
  company   Company?
  messages  GroupMessage[]
}

/// The group chat. userId null = the group's AI agent (its tool steps in `steps`).
model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String?
  text      String
  steps     Json?
  /// A file a member attached (image, PDF or text, at most about 3 MB); members can open it.
  fileName  String?
  fileMime  String?
  fileData  Bytes?
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

enum CompanyKind {
  /// A registered company (juristic id checked).
  COMPANY
  /// A group of friends with a shared wallet: no registration.
  GROUP
}

/// A company account: its own e-money account and agent wallet, run by a group of signers.
/// Members switch to it ("Acting as"); its deals lock only after N of M signers approve.
model Company {
  id            String      @id @default(cuid())
  kind          CompanyKind @default(COMPANY)
  name          String
  /// Masked registration id (Thai juristic id / Chinese unified social credit code) and its HMAC.
  /// Null for a group wallet.
  maskedTaxId   String?
  taxIdHash     String?     @unique
  currency      Currency
  customerId    String      @unique
  walletAddress String      @unique
  groupId       String      @unique
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById   String
  createdAt     DateTime    @default(now())
}

/// Someone asked to join a group; they become a member only by accepting.
model GroupInvite {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  /// Whether they join as a signer (votes on payments) or a member (proposes only).
  canSign     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// A join link (shown as a QR) a member shares; whoever opens it joins as a member, until it expires.
model GroupLink {
  token       String   @id
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([groupId])
}

enum GroupRuleKind {
  ADD_SIGNER
  REMOVE_SIGNER
  REMOVE_MEMBER
  SET_THRESHOLD
}

/// A change to the group's rules, decided by the same N of M signers as a payment.
model GroupRuleProposal {
  id           String              @id @default(cuid())
  groupId      String
  group        Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposerId   String
  kind         GroupRuleKind
  targetUserId String?
  threshold    Int?
  status       GroupProposalStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  decidedAt    DateTime?

  votes GroupRuleVote[]

  @@index([groupId])
}

model GroupRuleVote {
  proposalId String
  userId     String
  proposal   GroupRuleProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approve    Boolean
  createdAt  DateTime          @default(now())

  @@id([proposalId, userId])
}

model GroupMember {
  groupId  String
  userId   String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  /// Signers vote on payments and rule changes; other members propose only.
  canSign  Boolean   @default(true)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

enum GroupProposalStatus {
  OPEN
  REJECTED
  EXECUTED
  FAILED
}

model GroupProposal {
  id         String              @id @default(cuid())
  groupId    String
  group      Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposerId String
  /// The proposer's bank-deal draft; it is locked from the proposer's account once approved.
  /// Null for a payout.
  draftId    String?             @unique
  /// A payout from the company's / group's shared account to members: [{ userId, amount }] (minor units).
  payout     Json?
  /// A move on a deal of the shared wallet that pays money out, decided by the signers' vote:
  /// { dealId, index, action: "approve" (release a delivered milestone) | "accept" (pay a seller's offer) }.
  dealAction Json?
  status     GroupProposalStatus @default(OPEN)
  createdAt  DateTime            @default(now())

  votes GroupVote[]

  @@index([groupId])
}

model GroupVote {
  proposalId String
  userId     String
  proposal   GroupProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approve    Boolean
  createdAt  DateTime      @default(now())

  @@id([proposalId, userId])
}

/// A seller's delivery for one FileEscrow milestone (PDPA: the file and note live here and can be
/// deleted; the chain holds only the sha256 work hash and a commitment to the key).
model DealDelivery {
  id           String    @id @default(cuid())
  /// FileEscrow address: deal ids restart with every escrow deployment.
  escrow       String
  dealId       Int
  index        Int
  sellerUserId String
  /// The seller's evidence: what was delivered and how it meets the acceptance criteria.
  note         String
  fileName     String?
  mime         String?
  size         Int?
  /// AES-256-GCM ciphertext of the file; the key below stays on the server (demo custody).
  ciphertext   Bytes?
  iv           String?
  tag          String?
  fileKey      String?
  /// Parcel milestones: the carrier and tracking number, and when it was handed to the post.
  carrier      String?
  tracking     String?
  shippedAt    DateTime?
  /// sha256 of the file (or of the note, or of the parcel record, when there is no file): the work
  /// hash anchored on-chain.
  sha256       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([escrow, dealId, index])
}

// ---------------------------------------------------------------------------------------------
// Invited sellers: someone without an account is hired through a link. The server runs an agent
// wallet for them (the contracts see an ordinary seller wallet); the link is the only credential,
// so it is stored as a hash, and the payout destination can be set once and never changed.
// ---------------------------------------------------------------------------------------------

enum PayoutMethod {
  /// A Mock Bank account number; the account holder's name must match.
  MOCKBANK
  /// PromptPay: phone, citizen id or e-wallet id, typed or read from a PromptPay QR code.
  PROMPTPAY
  /// Another bank's account number (simulated transfer).
  BANK
}

model SellerInvite {
  id              String        @id @default(cuid())
  /// sha256 of the link's secret; the secret itself is shown to the buyer once.
  tokenHash       String        @unique
  /// The link's secret, encrypted for the inviter (shown again on the deal's page).
  tokenEnc        String?
  /// The buyer who invited them.
  userId          String
  buyerWallet     String
  /// The agent wallet the server runs for the invited seller.
  sellerWallet    String        @unique
  name            String
  currency        Currency
  payoutMethod    PayoutMethod?
  /// Account number or PromptPay id, as entered.
  payoutTarget    String?
  /// Bank code for BANK payouts (e.g. KBANK).
  payoutBank      String?
  payoutName      String?
  /// The Mock Bank account paid for MOCKBANK payouts.
  payoutAccountId String?
  payoutSetAt     DateTime?
  /// BANK payouts through Opn Payments (test mode): the recipient created for this seller.
  opnRecipientId  String?
  /// A seller who already has an account opened the link signed in: the invite is linked to them
  /// (earnings to their own wallet account, the deals listed in their app).
  claimedByUserId String?
  claimedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([claimedByUserId])
}

// ---------------------------------------------------------------------------------------------
// Disputes: the buyer's reason, and the neutral arbiter's decision. A dispute about the released
// key is checked mechanically (does the key open the file with the anchored hash?); a dispute
// about the work goes to the AI arbiter, which resolves on-chain only when it is confident and
// otherwise leaves it for a human arbiter. The chain holds only the outcome (resolve tx).
// ---------------------------------------------------------------------------------------------

enum DisputeStatus {
  OPEN
  DECIDING
  /// Waiting for the parties: to accept or reject the mediator's proposal, or to accept or appeal a verdict.
  AWAITING
  NEEDS_REVIEW
  RESOLVED
}

model DealDispute {
  id              String        @id @default(cuid())
  escrow          String
  dealId          Int
  index           Int
  /// "work": the buyer objects to the delivery; "key": the released key does not open the file.
  phase           String
  reason          String
  raisedByUserId  String?
  status          DisputeStatus @default(OPEN)
  /// "seller" (pay out) or "buyer" (refund).
  decision        String?
  confidence      Float?
  rationale       String?
  /// [{ criterion, met, evidence }] from the arbiter.
  findings        Json?
  /// "ai:<model>", "check:key" or "admin:<userId>".
  decidedBy       String?
  txHash          String?
  /// Escrows that can split (FileEscrow v2): MEDIATION → PANEL (3 models) → APPEAL (5 models).
  /// "CHECK" for a key dispute (decided mechanically) and "LEGACY" for the old one-model ruling.
  stage           String        @default("MEDIATION")
  /// The seller's side of the story, given when they reply.
  sellerStatement String?
  /// The mediator's proposal: { sellerBps, rationale, findings, model, signer, signature }.
  proposal        Json?
  /// "ACCEPT" or "REJECT" to the mediator's proposal; "ACCEPT" or "APPEAL" to the panel's verdict.
  buyerReply      String?
  sellerReply     String?
  /// When the current wait ends: silence on a proposal moves to the panel; on a verdict, executes it.
  replyBy         DateTime?
  /// Votes: [{ model, sellerBps, rationale, findings, signer, signature }].
  panel           Json?
  panelBps        Int?
  appealedBy      String?
  appeal          Json?
  appealBps       Int?
  /// The seller's share actually paid out on-chain, in basis points.
  sellerBps       Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([escrow, dealId, index])
}

/// An offer the user turned down in Approvals. Only the offer's creator can cancel it on-chain, so
/// declining is recorded here: it leaves the decliner's queue and the other side sees it was declined.
model DeclinedOffer {
  id        String   @id @default(cuid())
  userId    String
  escrow    String
  dealId    Int
  createdAt DateTime @default(now())

  @@unique([userId, escrow, dealId])
  @@index([escrow, dealId])
}

// ---------------------------------------------------------------------------------------------
// The agent's memory: what the user calls their contacts, and up to five saved chats per wallet.
// ---------------------------------------------------------------------------------------------

/// A nickname the user uses for a contact ("my designer", "พี่เอ"); the agent resolves it to the
/// contact's wallet on the server, so the model still never sees an address.
model ContactAlias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alias     String
  address   String
  createdAt DateTime @default(now())

  @@unique([userId, alias])
}

model AgentChat {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress String
  title         String
  /// [{ kind: "user" | "agent" | "error", text, at, steps? }]: the chat as the UI shows it.
  messages      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, walletAddress])
}

// ---------------------------------------------------------------------------------------------
// KYC: identity verified through a national digital ID (mock ThaID for Thai users, mock National
// Network Identity 网号/网证 for Chinese users), over OpenID Connect. PDPA / PIPL: the ID number is
// never stored; only a salted hash (to stop one person verifying many accounts) and a masked form.
// ---------------------------------------------------------------------------------------------

enum KycProvider {
  THAID
  CN_NETID
}

model KycVerification {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     KycProvider
  /// HMAC of the national id (ThaID) or the 网号 (China): one identity verifies one account.
  subjectHash  String      @unique
  /// e.g. 1-1234-xxxxx-xx-1 or WH****8F2K
  maskedId     String
  verifiedName String
  verifiedAt   DateTime    @default(now())
}

/// Authorization codes issued by the mock identity providers (single use, 5 minutes).
model MockIdCode {
  /// sha256 of the code
  id            String      @id
  provider      KycProvider
  clientId      String
  redirectUri   String
  codeChallenge String
  nonce         String
  /// The identity the user approved in the mock app.
  claims        Json
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}

/// A card linked through Stripe (test mode) as a second funding source: when the Mock Bank balance
/// is short at "Approve & lock", the shortfall is charged here off-session and credited (TOPUP).
model StripeLink {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  paymentMethodId String
  brand           String
  last4           String
  expMonth        Int
  expYear         Int
  createdAt       DateTime @default(now())
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A sign-up's identity check. Opening the wallet account (THB or CNY e-money) waits for APPROVED.
/// The demo approves at once (KYC_AUTO_APPROVE); with it off, a reviewer decides at /admin/kyc.
/// PDPA / PIPL: only a masked id and an HMAC of it are kept, never the number itself.
model KycApplication {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// TH or CN: decides the wallet's currency (THB or CNY).
  country     String
  /// THAID, CN_NETID (digital ID) or DOCUMENT (typed in, checked by a reviewer).
  method      String
  legalName   String
  idType      String
  maskedId    String
  subjectHash String
  birthDate   String?
  status      KycStatus @default(PENDING)
  reviewer    String?
  reviewNote  String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

/// One real (test-mode) bank transfer through Opn Payments to an invited seller, per paid milestone.
/// The row is written before calling Opn, keyed by the milestone's payout, so it is sent once.
model OpnPayout {
  id            String   @id @default(cuid())
  /// The PAYOUT ledger transfer this sends on (unique: one bank transfer per payout).
  payoutKey     String   @unique
  inviteId      String
  recipientId   String
  amount        BigInt
  opnTransferId String?
  /// PENDING (not sent yet), SENT, PAID or FAILED
  status        String   @default("PENDING")
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([inviteId])
}

/// A note between the parties of a deal: the buyer asks for changes to a delivery, or for a
/// revised offer. Off-chain: the review window on-chain keeps running.
model DealNote {
  id        String   @id @default(cuid())
  escrow    String
  dealId    Int
  index     Int?
  /// "CHANGES" (to a delivery) or "REVISION" (to an offer).
  kind      String
  author    String
  text      String
  createdAt DateTime @default(now())

  @@index([escrow, dealId])
}

/// What the user chose on Profile & Privacy.
/// The user's saved delivery address (Thai style: province, district, sub-district picked from the
/// official list, postcode from the sub-district). Offered for parcel deals; the AI can read and
/// change it when the user asks.
model UserAddress {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient   String
  phone       String
  /// House number, village / building, soi, road.
  line        String
  subdistrict String
  district    String
  province    String
  postcode    String
  updatedAt   DateTime @updatedAt
}

model UserPreference {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Show amounts also in the other currency at the fixed demo rate ("THB" | "CNY" | null = off).
  showAlso     String?
  /// Off: the AI chat is disabled for this user.
  aiChat       Boolean  @default(true)
  /// Keep deal terms, chats and evidence for disputes; off deletes chats after a deal settles.
  keepDealDocs Boolean  @default(true)
  emailNotify  Boolean  @default(false)
  /// A linked card covers a short balance when a deal is approved.
  cardCover    Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

/// A buyer without an account: a seller offers them work or goods through a link. The server runs a
/// wallet for them (like an invited seller's), they pay the offer by card (Stripe test mode) and
/// approve the delivery on the link's page. The link's secret is the only credential (hash stored).
model BuyerInvite {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  /// The link's secret, encrypted for the inviter (shown again on the deal's page).
  tokenEnc     String?
  /// The seller who invited them, and the wallet that sells.
  userId       String
  sellerWallet String
  buyerWallet  String   @unique
  name         String
  currency     Currency
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}
