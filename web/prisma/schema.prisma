generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core tables). People sign in through the Mock Bank, see src/lib/mock-bank-auth.ts.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  profile         Profile?
  wallets         UserWallet[]
  bankCustomer    BankCustomer?
  dealDrafts      DealDraft[]
  friendsAsked    Friendship[]     @relation("friendRequester")
  friendsReceived Friendship[]     @relation("friendAddressee")
  groups          GroupMember[]
  aliases         ContactAlias[]
  agentChats      AgentChat[]
  kyc             KycVerification?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per linked sign-in method (providerId "google" | "apple").
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// App data linked to a user
// ---------------------------------------------------------------------------

/// Basic personal details, 1:1 with User. Everything optional so sign-in never blocks on it.
model Profile {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String?
  lastName     String?
  phone        String?
  dateOfBirth  DateTime? @db.Date
  organization String?
  jobTitle     String?
  country      String?   @db.Char(2) /// ISO 3166-1 alpha-2, e.g. "TH"
  locale       String    @default("en") /// "en" | "th", matches the UI language switch
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum WalletRole {
  OWNER
  APPROVER
  CONTRACTOR
  VIEWER
}

/// Links a signed-in user to on-chain AgentWallets (the indexed Wallet table) and, through it,
/// to that wallet's Proposal / Approval / Event rows.
model UserWallet {
  userId        String
  walletAddress String
  role          WalletRole @default(OWNER)
  label         String?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet     @relation(fields: [walletAddress], references: [address], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, walletAddress])
  @@index([walletAddress])
}

/// Who approved which proposal, so the UI doesn't need one hasApproved() call per approver.
model Approval {
  walletAddress   String
  proposalId      BigInt
  approver        String
  approvedAtBlock BigInt
  approvedAt      DateTime
  proposal        Proposal @relation(fields: [walletAddress, proposalId], references: [walletAddress, proposalId])

  @@id([walletAddress, proposalId, approver])
}

/// Full audit log: every AgentWallet + MilestoneEscrow event, unpaginated.
model Event {
  id            String   @id @default(cuid())
  walletAddress String
  txHash        String
  logIndex      Int
  eventName     String
  args          Json
  blockNumber   BigInt
  blockTime     DateTime
  wallet        Wallet   @relation(fields: [walletAddress], references: [address])

  @@unique([txHash, logIndex])
  @@index([walletAddress, blockNumber])
}

/// Last block the indexer processed per contract, so it resumes instead of rescanning from 0.
model IndexerSyncState {
  contractAddress String   @id
  lastSyncedBlock BigInt
  updatedAt       DateTime @updatedAt
}

/// Mirrors AgentWallet.Proposal, kept in sync from ProposalCreated/Approved/Executed/Cancelled.
model Proposal {
  walletAddress  String
  proposalId     BigInt
  kind           ProposalKind
  proposer       String
  target         String
  amount         Decimal        @db.Decimal(78, 0)
  milestoneIndex Decimal        @db.Decimal(78, 0)
  data           String
  reason         String
  expiresAt      DateTime
  approverEpoch  BigInt
  approvalsCount Int            @default(0)
  status         ProposalStatus @default(OPEN)
  createdBlock   BigInt
  updatedBlock   BigInt
  approvals      Approval[]
  wallet         Wallet         @relation(fields: [walletAddress], references: [address])

  @@id([walletAddress, proposalId])
  @@index([walletAddress, status])
}

/// One row per AgentWallet deployed by AgentWalletFactory (WalletCreated event).
model Wallet {
  address      String       @id
  owner        String
  agent        String
  creator      String
  token        String
  createdBlock BigInt
  createdAt    DateTime
  events       Event[]
  proposals    Proposal[]
  members      UserWallet[]

  @@index([owner])
}

enum ProposalKind {
  TRANSFER
  RELEASE_MILESTONE
  CALL
  SETUP_DEAL
}

enum ProposalStatus {
  OPEN
  EXECUTED
  CANCELLED
  EXPIRED
  STALE
}

// ---------------------------------------------------------------------------------------------
// Mock Bank (demo only): simulated baht and yuan, not real money. Amounts are integer minor units
// (satang, fen). Every mTHB / mCNY on-chain is backed by money in that currency's RESERVE account:
// reserve balance == totalSupply. Money never moves between currencies.
// ---------------------------------------------------------------------------------------------

/// Which demo bank: THB = Mock Bank Thailand, CNY = Mock Bank China.
enum Currency {
  THB
  CNY
}

enum BankCustomerType {
  PERSONAL
  COMPANY
}

/// A Mock Bank customer. Signing in to the app means signing in here and letting the app use some
/// of the customer's accounts (like open-banking consent), instead of Google or Apple.
model BankCustomer {
  id          String           @id @default(cuid())
  currency    Currency
  /// Chosen at sign-up, unique within one bank.
  username    String
  displayName String
  type        BankCustomerType @default(PERSONAL)
  /// Demo PIN, hashed (scrypt). Never a real bank PIN.
  pinHash     String
  failedPins  Int              @default(0)
  lockedUntil DateTime?
  /// The app user this customer signs in as; set on the first consent, cleared when the user is deleted.
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// When the customer last agreed to let the app use the linked accounts.
  consentedAt DateTime?
  /// Reviewer access to the chain explorer (/admin/chain). Set only by scripts/make-admin.mts.
  isAdmin     Boolean          @default(false)
  createdAt   DateTime         @default(now())

  accounts BankAccount[]

  @@unique([currency, username])
}

enum BankAccountKind {
  USER
  RESERVE
  /// Money leaving the demo bank for a PromptPay id or another bank (simulated, one per currency).
  EXTERNAL
}

enum BankTransferKind {
  /// Demo money entering the bank (a sandbox's seed). The only kind with no source account.
  DEPOSIT
  /// Buyer → reserve, right before mTHB / mCNY is minted for a deal.
  FUND
  /// Reserve → buyer, when funding failed for certain or a deal refunds.
  REFUND
  /// Reserve → seller (or buyer), after the tokens are redeemed on-chain.
  PAYOUT
  /// An invited seller's earnings → the payout destination they chose (a Mock Bank account, or
  /// the EXTERNAL account standing in for PromptPay / another bank).
  WITHDRAW
  /// Money paid in by card through Stripe (test mode), credited once per Checkout Session.
  TOPUP
}

model BankAccount {
  id           String          @id @default(cuid())
  kind         BankAccountKind @default(USER)
  /// The on-chain address this account belongs to (a sandbox's AgentWallet, or a seller). Null for the reserve.
  ownerAddress String?         @unique
  label        String
  /// Never negative: a debit only happens together with a balance check in the same statement.
  balance      BigInt          @default(0)
  currency     Currency        @default(THB)
  /// Passbook number shown to the customer. Null for the reserves and sandbox accounts.
  accountNo    String?         @unique
  customerId   String?
  customer     BankCustomer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Set while the customer lets the app use this account. Only linked accounts are shown or debited.
  linkedAt     DateTime?
  /// The linked account the app debits by default.
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())

  outgoing BankTransfer[] @relation("outgoing")
  incoming BankTransfer[] @relation("incoming")

  @@index([customerId])
}

model BankTransfer {
  id             String           @id @default(cuid())
  /// One key per action, e.g. "deal-123:fund"; the database refuses a second transfer with it.
  idempotencyKey String           @unique
  kind           BankTransferKind
  fromId         String?
  toId           String
  amount         BigInt
  /// The on-chain transaction this transfer mirrors (mint or redeem), once known.
  txHash         String?
  createdAt      DateTime         @default(now())

  /// Restrict: a deleted account must never turn a transfer into what looks like a deposit.
  from BankAccount? @relation("outgoing", fields: [fromId], references: [id], onDelete: Restrict)
  to   BankAccount  @relation("incoming", fields: [toId], references: [id])

  @@index([fromId])
  @@index([toId])
}

// ---------------------------------------------------------------------------------------------
// Deal drafts (PDPA): what the agent drafts for a bank-paid file deal. Names, titles and
// milestone descriptions live only here, where they can be deleted; the chain gets their hash.
// ---------------------------------------------------------------------------------------------

enum DealDraftStatus {
  DRAFT
  FUNDED
  FAILED
  CANCELLED
}

/// Who drafted the deal: the buyer (locks money when approved) or the seller (offers work; the
/// buyer pays in when they accept).
enum DraftSide {
  BUY
  SELL
}

/// What is traded: HIRE is work done by a person (a service), GOODS is a thing bought (a file, or a
/// parcel shipped by post).
enum DealKind {
  HIRE
  GOODS
}

model DealDraft {
  id            String          @id @default(cuid())
  side          DraftSide       @default(BUY)
  kind          DealKind        @default(HIRE)
  /// Delivery address for parcel milestones (shown to both parties only).
  shipTo        String?
  /// SELL drafts: the buyer's wallet the offer is made to. BUY drafts: null (the wallet is the buyer).
  buyer         String?
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress String
  seller        String
  title         String
  summary       String
  /// [{ name, amount (minor units, string), hasFile, due, acceptance }]
  milestones    Json
  reviewHours   Int
  /// sha256 of the terms, written on-chain as the offer's termsURI ("sha256:<hex>").
  termsHash     String
  status        DealDraftStatus @default(DRAFT)
  /// The mandate's EIP-712 digest once approved: the funding record's id.
  fundingId     String?
  dealId        Int?
  /// Last funding result (steps, tx hashes, error), for the UI.
  result        Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, walletAddress])
}

// ---------------------------------------------------------------------------------------------
// Social: friends and groups. Being friends never allowlists anyone: adding a friend as a payee
// is a separate owner action. A group deal needs `threshold` member votes before the proposer's
// own bank account is debited, so a group shares decisions, not a pot of idle money.
// ---------------------------------------------------------------------------------------------

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  requester   User             @relation("friendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("friendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Group {
  id          String   @id @default(cuid())
  name        String
  currency    Currency
  createdById String
  /// Member votes a group deal needs before it is locked (N of M).
  threshold   Int
  createdAt   DateTime @default(now())

  members   GroupMember[]
  proposals GroupProposal[]
}

model GroupMember {
  groupId  String
  userId   String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

enum GroupProposalStatus {
  OPEN
  REJECTED
  EXECUTED
  FAILED
}

model GroupProposal {
  id         String              @id @default(cuid())
  groupId    String
  group      Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposerId String
  /// The proposer's bank-deal draft; it is locked from the proposer's account once approved.
  draftId    String              @unique
  status     GroupProposalStatus @default(OPEN)
  createdAt  DateTime            @default(now())

  votes GroupVote[]

  @@index([groupId])
}

model GroupVote {
  proposalId String
  userId     String
  proposal   GroupProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approve    Boolean
  createdAt  DateTime      @default(now())

  @@id([proposalId, userId])
}

/// A seller's delivery for one FileEscrow milestone (PDPA: the file and note live here and can be
/// deleted; the chain holds only the sha256 work hash and a commitment to the key).
model DealDelivery {
  id           String    @id @default(cuid())
  /// FileEscrow address: deal ids restart with every escrow deployment.
  escrow       String
  dealId       Int
  index        Int
  sellerUserId String
  /// The seller's evidence: what was delivered and how it meets the acceptance criteria.
  note         String
  fileName     String?
  mime         String?
  size         Int?
  /// AES-256-GCM ciphertext of the file; the key below stays on the server (demo custody).
  ciphertext   Bytes?
  iv           String?
  tag          String?
  fileKey      String?
  /// Parcel milestones: the carrier and tracking number, and when it was handed to the post.
  carrier      String?
  tracking     String?
  shippedAt    DateTime?
  /// sha256 of the file (or of the note, or of the parcel record, when there is no file): the work
  /// hash anchored on-chain.
  sha256       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([escrow, dealId, index])
}

// ---------------------------------------------------------------------------------------------
// Invited sellers: someone without an account is hired through a link. The server runs an agent
// wallet for them (the contracts see an ordinary seller wallet); the link is the only credential,
// so it is stored as a hash, and the payout destination can be set once and never changed.
// ---------------------------------------------------------------------------------------------

enum PayoutMethod {
  /// A Mock Bank account number; the account holder's name must match.
  MOCKBANK
  /// PromptPay: phone, citizen id or e-wallet id, typed or read from a PromptPay QR code.
  PROMPTPAY
  /// Another bank's account number (simulated transfer).
  BANK
}

model SellerInvite {
  id              String        @id @default(cuid())
  /// sha256 of the link's secret; the secret itself is shown to the buyer once.
  tokenHash       String        @unique
  /// The buyer who invited them.
  userId          String
  buyerWallet     String
  /// The agent wallet the server runs for the invited seller.
  sellerWallet    String        @unique
  name            String
  currency        Currency
  payoutMethod    PayoutMethod?
  /// Account number or PromptPay id, as entered.
  payoutTarget    String?
  /// Bank code for BANK payouts (e.g. KBANK).
  payoutBank      String?
  payoutName      String?
  /// The Mock Bank account paid for MOCKBANK payouts.
  payoutAccountId String?
  payoutSetAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime      @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------------------------
// Disputes: the buyer's reason, and the neutral arbiter's decision. A dispute about the released
// key is checked mechanically (does the key open the file with the anchored hash?); a dispute
// about the work goes to the AI arbiter, which resolves on-chain only when it is confident and
// otherwise leaves it for a human arbiter. The chain holds only the outcome (resolve tx).
// ---------------------------------------------------------------------------------------------

enum DisputeStatus {
  OPEN
  DECIDING
  NEEDS_REVIEW
  RESOLVED
}

model DealDispute {
  id             String        @id @default(cuid())
  escrow         String
  dealId         Int
  index          Int
  /// "work": the buyer objects to the delivery; "key": the released key does not open the file.
  phase          String
  reason         String
  raisedByUserId String?
  status         DisputeStatus @default(OPEN)
  /// "seller" (pay out) or "buyer" (refund).
  decision       String?
  confidence     Float?
  rationale      String?
  /// [{ criterion, met, evidence }] from the arbiter.
  findings       Json?
  /// "ai:<model>", "check:key" or "admin:<userId>".
  decidedBy      String?
  txHash         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([escrow, dealId, index])
}

/// An offer the user turned down in Approvals. Only the offer's creator can cancel it on-chain, so
/// declining is recorded here: it leaves the decliner's queue and the other side sees it was declined.
model DeclinedOffer {
  id        String   @id @default(cuid())
  userId    String
  escrow    String
  dealId    Int
  createdAt DateTime @default(now())

  @@unique([userId, escrow, dealId])
  @@index([escrow, dealId])
}

// ---------------------------------------------------------------------------------------------
// The agent's memory: what the user calls their contacts, and up to five saved chats per wallet.
// ---------------------------------------------------------------------------------------------

/// A nickname the user uses for a contact ("my designer", "พี่เอ"); the agent resolves it to the
/// contact's wallet on the server, so the model still never sees an address.
model ContactAlias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alias     String
  address   String
  createdAt DateTime @default(now())

  @@unique([userId, alias])
}

model AgentChat {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress String
  title         String
  /// [{ kind: "user" | "agent" | "error", text, at, steps? }]: the chat as the UI shows it.
  messages      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, walletAddress])
}

// ---------------------------------------------------------------------------------------------
// KYC: identity verified through a national digital ID (mock ThaID for Thai users, mock National
// Network Identity 网号/网证 for Chinese users), over OpenID Connect. PDPA / PIPL: the ID number is
// never stored; only a salted hash (to stop one person verifying many accounts) and a masked form.
// ---------------------------------------------------------------------------------------------

enum KycProvider {
  THAID
  CN_NETID
}

model KycVerification {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     KycProvider
  /// HMAC of the national id (ThaID) or the 网号 (China): one identity verifies one account.
  subjectHash  String      @unique
  /// e.g. 1-1234-xxxxx-xx-1 or WH****8F2K
  maskedId     String
  verifiedName String
  verifiedAt   DateTime    @default(now())
}

/// Authorization codes issued by the mock identity providers (single use, 5 minutes).
model MockIdCode {
  /// sha256 of the code
  id            String      @id
  provider      KycProvider
  clientId      String
  redirectUri   String
  codeChallenge String
  nonce         String
  /// The identity the user approved in the mock app.
  claims        Json
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}
