# Copy to .env.local for local dev (see README). Server-side only; nothing here is exposed to the browser.
CHAIN=hardhat                      # hardhat | baseSepolia
RPC_URL=http://127.0.0.1:8545      # https://sepolia.base.org for Base Sepolia
USDC_ADDRESS=
ESCROW_ADDRESS=
FACTORY_ADDRESS=
START_BLOCK=0
# v0.8 Mock Bank: mTHB token and the file-exchange escrow.
MTHB_ADDRESS=
# Optional until mCNY is deployed; Chinese-bank customers get a wallet only once it is set.
MCNY_ADDRESS=
FILE_ESCROW_ADDRESS=
# Neutral dispute resolver for every deal. Must not be the owner, agent or contractor address.
ARBITER_ADDRESS=

# Demo role keys. TESTNET ONLY. The server signs for every role so judges can click through.
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
CONTRACTOR_PRIVATE_KEY=
# The Mock Bank's minting key (BANK_ROLE on mTHB). Must differ from the owner key, which is the mTHB admin.
BANK_PRIVATE_KEY=

# Mock Bank ledger (Neon Postgres). Prisma reads these from .env.
# DATABASE_URL=                    # pooled connection
# DIRECT_URL=                      # direct connection

# LLM: pick ONE provider. All go through the Anthropic SDK (Messages API shape).
# a) Any Anthropic-compatible gateway, e.g. the PSU AI gateway:
LLM_BASE_URL=                      # https://ai.psu.blue/anthropic
LLM_API_KEY=
# b) OpenRouter:  OPENROUTER_API_KEY=
# c) Anthropic:   ANTHROPIC_API_KEY=
# Model. Defaults: openai/gpt-6-luna (gateway), anthropic/claude-opus-5.5 (OpenRouter), claude-opus-5-5 (Anthropic).
LLM_MODEL=

# Database: Neon Postgres. Pooled URL for the app, direct (no "-pooler", no channel_binding) for the Prisma CLI.
DATABASE_URL=
DIRECT_URL=

# Auth (Better Auth). People sign in through the Mock Bank (src/lib/mock-bank-auth.ts); no OAuth keys needed.
BETTER_AUTH_SECRET=                # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Optional sign-in with Google / Apple: the login screen shows only the configured ones.
# Redirect URIs: <BETTER_AUTH_URL>/api/auth/callback/google and .../callback/apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_ID=

# Password reset emails (Resend). Unset: in development the link is printed to the server log,
# in production "Forgot password?" is hidden.
RESEND_API_KEY=
EMAIL_FROM="MilestonePay <onboarding@resend.dev>"
