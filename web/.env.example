# Copy to .env.local for local dev (see README). Server-side only; nothing here is exposed to the browser.
CHAIN=hardhat                      # hardhat | baseSepolia
RPC_URL=http://127.0.0.1:8545      # https://sepolia.base.org for Base Sepolia
USDC_ADDRESS=
ESCROW_ADDRESS=
FACTORY_ADDRESS=
START_BLOCK=0

# Demo role keys. TESTNET ONLY. The server signs for every role so judges can click through.
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
APPROVER_A_PRIVATE_KEY=
APPROVER_B_PRIVATE_KEY=
CONTRACTOR_PRIVATE_KEY=

# LLM: set ONE of these. OpenRouter uses its Anthropic-compatible endpoint with the Anthropic SDK.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Defaults: anthropic/claude-opus-5.5 (OpenRouter) or claude-opus-5-5 (Anthropic).
LLM_MODEL=
