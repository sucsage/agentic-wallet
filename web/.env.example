# Copy to .env.local for local dev (see README). Server-side only; nothing here is exposed to the browser.
CHAIN=hardhat                      # hardhat | baseSepolia
RPC_URL=http://127.0.0.1:8545      # https://sepolia.base.org for Base Sepolia
USDC_ADDRESS=
ESCROW_ADDRESS=
FACTORY_ADDRESS=
START_BLOCK=0

# Demo role keys. TESTNET ONLY. The server signs for every role so judges can click through.
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
CONTRACTOR_PRIVATE_KEY=

# LLM: pick ONE provider. All go through the Anthropic SDK (Messages API shape).
# a) Any Anthropic-compatible gateway, e.g. the PSU AI gateway:
LLM_BASE_URL=                      # https://ai.psu.blue/anthropic
LLM_API_KEY=
# b) OpenRouter:  OPENROUTER_API_KEY=
# c) Anthropic:   ANTHROPIC_API_KEY=
# Model. Defaults: openai/gpt-6-luna (gateway), anthropic/claude-opus-5.5 (OpenRouter), claude-opus-5-5 (Anthropic).
LLM_MODEL=

# Database: Neon Postgres. Pooled URL for the app, direct (no "-pooler", no channel_binding) for the Prisma CLI.
DATABASE_URL=
DIRECT_URL=

# Auth (Better Auth). Sign-in is optional; each provider shows up only when its keys are set.
# Callback URLs to register: $BETTER_AUTH_URL/api/auth/callback/google and .../callback/apple
BETTER_AUTH_SECRET=                # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer → Identifiers → Services ID (= APPLE_CLIENT_ID), with Sign in with Apple enabled.
# Apple requires an HTTPS return URL on a real domain (no localhost; use the Vercel URL or a tunnel).
APPLE_CLIENT_ID=                   # Services ID, e.g. com.example.agenticwallet.web
APPLE_TEAM_ID=
APPLE_KEY_ID=                      # Keys → Sign in with Apple key
APPLE_PRIVATE_KEY=                 # contents of AuthKey_XXXX.p8, newlines as \n
APPLE_APP_BUNDLE_ID=               # optional: iOS app bundle ID for native sign-in
