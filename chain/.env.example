# Chain server settings (copy to chain/.env on the chain server; never commit chain/.env).
# A DNS name pointing at this server; Caddy gets its HTTPS certificate automatically.
CHAIN_DOMAIN=chain.example.com
# Shared secret the web app sends as X-Chain-Key. Generate with: openssl rand -hex 32
# Put the same value in Vercel as CHAIN_API_KEY.
CHAIN_API_KEY=
