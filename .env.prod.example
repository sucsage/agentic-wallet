# Production environment: ONE file for every container in docker-compose.prod.yml.
#   cp .env.prod.example .env.prod   (never commit .env.prod)
# Generate secrets with:  openssl rand -hex 32     (hex keeps them safe inside the database URL)

# ---- Database (service `postgres`; its own container, data in the pgdata volume) ----------------
POSTGRES_USER=aw
POSTGRES_PASSWORD=
POSTGRES_DB=agenticwallet
DB_PUSH=true                       # create/update tables on start (prisma db push; refuses data loss). false = never touch the schema

# ---- Web ---------------------------------------------------------------------------------------
WEB_PORT=3000                      # loopback port for your reverse proxy / tunnel
BETTER_AUTH_URL=                   # the public https address, e.g. https://app.example.com
APP_ORIGIN=                        # same value
BETTER_AUTH_SECRET=                # openssl rand -hex 32
CRON_SECRET=                       # openssl rand -hex 32 (the daily job sends it as a Bearer token)
MOCK_IDP_SECRET=                   # openssl rand -hex 32 (signs the demo digital-ID codes)
KYC_AUTO_APPROVE=true              # demo: identity checks pass at once. Turn off for real review
DISPUTES=on

# ---- Chain (existing one; not started by this compose) -----------------------------------------
CHAIN=besu                         # besu | baseSepolia
RPC_URL=                           # Besu server URL (needs CHAIN_TOKEN) or https://sepolia.base.org
CHAIN_TOKEN=                       # Besu only: bearer JWT (node scripts/chain-token.mjs)
# DB_SCHEMA=                       # leave unset (an empty value breaks the schema step): this database belongs to this chain alone
START_BLOCK=0
USDC_ADDRESS=
ESCROW_ADDRESS=
FACTORY_ADDRESS=
MTHB_ADDRESS=
MCNY_ADDRESS=
FILE_ESCROW_ADDRESS=
CHAIN_ANCHOR_ADDRESS=
ARBITER_ADDRESS=

# ---- Role keys (the server signs for every role). Real values only here, never in git ----------
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
CONTRACTOR_PRIVATE_KEY=
ARBITER_PRIVATE_KEY=
BANK_PRIVATE_KEY=

# ---- LLM: ONE provider --------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# ---- Optional ----------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
