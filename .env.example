# Root environment for the local Docker stack (docker compose up --build). ONE file for every container.
# Works as is: compose reads this file, then .env (if you create one) on top of it.
# To add your LLM key:  cp .env.example .env   and fill in the LLM section of .env.
# TESTNET/LOCAL ONLY. The keys below are Hardhat's public test keys; never use them anywhere else.

# ---- Ports on your machine ----------------------------------------------------------------------
WEB_PORT=3000                      # if you change it, change BETTER_AUTH_URL and APP_ORIGIN to match
CHAIN_PORT=8545                    # Hardhat JSON-RPC, for MetaMask or cast (chain id 31337)
POSTGRES_PORT=55432

# ---- Postgres (service `postgres`) --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=awlocal
POSTGRES_DB=agenticwallet
DATABASE_URL=postgresql://postgres:awlocal@postgres:5432/agenticwallet
DIRECT_URL=postgresql://postgres:awlocal@postgres:5432/agenticwallet

# ---- Chain (service `chain`; contract addresses are written by `deployer`, not set here) ---------
CHAIN=hardhat
RPC_URL=http://chain:8545

# ---- Demo role keys (the server signs for every role so judges can click through) ---------------
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
CONTRACTOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
ARBITER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
BANK_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# ---- App ---------------------------------------------------------------------------------------
BETTER_AUTH_SECRET=local-docker-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
MOCK_IDP_SECRET=local-docker-idp-secret-0123456789
KYC_AUTO_APPROVE=true              # mock national ID check passes at once
SEED_DEMO_DATA=true                # a one-time job fills demo people, wallets, transfers and deals; false = empty system
DISPUTES=on                        # lets judges open and rule on disputes (ignored on branches without the switch)

# ---- LLM (needed for the chat agent and the AI arbiter) -- pick ONE provider ---------------------
# a) Anthropic-compatible gateway:
LLM_BASE_URL=
LLM_API_KEY=
# b) OpenRouter:
OPENROUTER_API_KEY=
# c) Anthropic:
ANTHROPIC_API_KEY=
# Optional model override.
LLM_MODEL=
